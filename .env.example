# Copy to .env and fill in the values. The application loads this file automatically.
# Mock mode needs no provider credentials.
ADAPTIVE_ROUTER_MOCK_MODE=false

# OpenAI-compatible provider
OPENAI_API_KEY=replace-with-your-api-key
ADAPTIVE_ROUTER_OPENAI_BASE_URL=https://api.openai.com/v1
ADAPTIVE_ROUTER_REQUEST_TIMEOUT_SECONDS=60

# Strategy models
ADAPTIVE_ROUTER_DIRECT_MODEL=gpt-4o-mini
ADAPTIVE_ROUTER_STRONG_MODEL=gpt-4o
ADAPTIVE_ROUTER_TOOL_MODEL=gpt-4o-mini

# USD per 1,000 tokens
ADAPTIVE_ROUTER_DIRECT_INPUT_COST_PER_1K_TOKENS=0
ADAPTIVE_ROUTER_DIRECT_OUTPUT_COST_PER_1K_TOKENS=0
ADAPTIVE_ROUTER_STRONG_INPUT_COST_PER_1K_TOKENS=0
ADAPTIVE_ROUTER_STRONG_OUTPUT_COST_PER_1K_TOKENS=0
ADAPTIVE_ROUTER_TOOL_INPUT_COST_PER_1K_TOKENS=0
ADAPTIVE_ROUTER_TOOL_OUTPUT_COST_PER_1K_TOKENS=0

# Routing and reward settings
ADAPTIVE_ROUTER_MAX_TOOL_CALLS=3
ADAPTIVE_ROUTER_COST_PENALTY=0.1
ADAPTIVE_ROUTER_LATENCY_PENALTY=0.1
ADAPTIVE_ROUTER_EPSILON=0.1
ADAPTIVE_ROUTER_UCB_CONFIDENCE=2.0
ADAPTIVE_ROUTER_LINUCB_ALPHA=1.0

# JSONL run records
ADAPTIVE_ROUTER_PERSISTENCE_PATH=runs.jsonl
